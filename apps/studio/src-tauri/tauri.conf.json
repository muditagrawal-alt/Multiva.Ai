{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Multiva Studio",
  "version": "0.1.0",
  "identifier": "com.multiva.studio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Multiva Studio",
        "width": 900,
        "height": 420,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Offline Indian-language video dubbing",
    "longDescription": "Dub video into Indian languages on your own machine. Transcription, translation, voice cloning and lip sync all run locally; nothing is uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      }
    }
  }
}
